# Genel
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# LLM (lokal endpoint)
LLM_PRIMARY_ENDPOINT=http://localhost:8001/v1
LLM_FAST_ENDPOINT=http://localhost:8002/v1

# Vector DB
QDRANT_URL=http://localhost:6333

# Cache / Queue
REDIS_URL=redis://localhost:6379

# yargi-mcp — Resmi public instance (auth gerektirmez)
YARGI_MCP_URL=https://yargimcp.surucu.dev/mcp
# Lokal kurulum için: http://localhost:8000/mcp/
# YARGI_MCP_TOKEN=  # production'da Bearer token

YARGI_MCP_TIMEOUT_MS=30000

# Embedding
EMBEDDING_MODEL=BAAI/bge-m3

# STT / TTS (sadece mobil)
WHISPER_ENDPOINT=http://localhost:8005
COQUI_TTS_ENDPOINT=http://localhost:8006
