# ADALET-AGENT — ortam değişkenleri (docker-compose.yml ile birebir).
# Kopyala:  cp .env.example .env   ve aşağıdaki ZORUNLU secret'ları doldur.
# Secret üret:  openssl rand -hex 32

# ============================================================================
# ZORUNLU SECRET'LAR (boş bırakılırsa `docker compose up` HATA verir)
# ============================================================================
QDRANT_API_KEY=        # Qdrant erişim anahtarı (rand-hex)
JWT_SECRET=            # JWT imzalama (rand-hex 32+)
REDIS_PASSWORD=        # Redis AUTH
POSTGRES_PASSWORD=     # PostgreSQL şifre

# ============================================================================
# PostgreSQL (ilişkisel DB — feedback/api_key/audit)
# ============================================================================
POSTGRES_USER=adalet
POSTGRES_DB=adalet
# Backend bu URL'den bağlanır (servis adı = postgres). <PWD>'yi POSTGRES_PASSWORD
# ile AYNI yap (compose .env nesting'ine güvenme, elle yaz).
DATABASE_URL=postgresql+asyncpg://adalet:<PWD>@postgres:5432/adalet

# ============================================================================
# Auth
# ============================================================================
AUTH_ENABLED=1
JWT_TTL_SECONDS=86400
JWT_ISSUER=adalet-agent
JWT_AUDIENCE=adalet-agent-api
# B2B API key'leri için JSON dosya yolu (opsiyonel; yoksa boş)
API_KEYS_FILE=

# ============================================================================
# LLM  —  3 seçenek: openai (bulut, GPU'suz) · llamacpp_server (lokal GPU) · mock (dev/test)
# ============================================================================
# BULUT (önerilen, GPU gerekmez): LLM_MODE=openai + OPENAI_API_KEY ver → gpt-4o-mini.
#   Bu modda llama-server GEREKMEZ (compose'da 'local-llm' profili başlatılmaz).
# LOKAL GPU: LLM_MODE=llamacpp_server (aşağıdaki llama-server + LLAMA_MODEL_FILE gerekir).
# NOT: backend/.env.example bulut-öncelikli (openai) varsayar; bu compose dosyası lokal-LLM
#      odaklı olduğundan default llamacpp_server'dır — çelişki değil, iki farklı profil.
LLM_MODE=llamacpp_server
# LLM_MODE=openai                   # bulut (OPENAI_API_KEY gerekli); en kolay deploy
# LLM_MODE=mock                     # dev/test: gerçek cevap üretmez
LLM_SERVER_URL=http://llama-server:8080
# Production profilinde llama-server'a mount edilen gguf dosya adı + GPU layer:
LLAMA_MODEL_FILE=Qwen3.5-9B-UD-Q4_K_XL.gguf
LLAMA_NGL=99                        # tüm layer'lar GPU'ya (VRAM yeterliyse)

# ============================================================================
# Güvenlik / doğrulama (CLAUDE.md §1 — production'da SIFIR HALÜSİNASYON)
# ============================================================================
VERIFY_STRICT=1            # production: doğrulayıcı çökerse fail-CLOSED (reddet)
SANITIZE_ENABLED=1         # prompt-injection filtresi
PII_ENABLED=1              # TCKN/telefon/email/IBAN/plaka maskeleme
SECURITY_HSTS_ENABLED=1    # HTTPS (Caddy) arkasında HSTS

# ============================================================================
# TLS (production profili — Caddy)
# ============================================================================
# infra/Caddyfile içindeki domain (staging.adalet.app) ACME TLS için gerçek
# DNS A kaydı gerektirir. Domain'i kendi alanınla değiştir.

# ============================================================================
# Çalıştırma
#   Dev infra (mock, GPU gerekmez): docker compose -f docker-compose.dev.yml up -d
#     → backend'i lokal çalıştır: LLM_MODE=mock uv run uvicorn main:app --reload
#   Production (TLS + Qwen):    docker compose --profile production up -d
#     → +caddy (80/443 TLS) +llama-server (GPU, lokal gguf). Önkoşul: NVIDIA
#       GPU + nvidia-container-toolkit + backend/models/<gguf> + domain DNS.
# ============================================================================
