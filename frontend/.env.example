# ADALET frontend env örneği — kopyala: cp .env.example .env

# Backend (FastAPI) — dev proxy hedefi (/ask, /multimodal, ...)
VITE_BACKEND_URL=http://localhost:8000

# Supabase (auth + sohbet geçmişi) — Dashboard → Project Settings → API
# Bu iki değer zorunludur: uygulamada misafir modu yoktur, giriş/kayıt kapısı gösterilir.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# Production signup hardening: HIBP Pwned Passwords k-anonymity range check.
# Dev/test'te boş bırakılabilir; prod'da 1 tut.
VITE_HIBP_PASSWORD_CHECK=1
