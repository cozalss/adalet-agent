# ============================================================================
#  ADALET-AGENT backend — environment example
#  Bu dosyayı `.env` olarak kopyala ve değerleri ortamına göre doldur.
#  Production'da SIRRA dair değerleri SECRET MANAGER (Vault, AWS SM) ile yönet.
# ============================================================================

# ----------------- LLM ----------------------------------------------------
# mock              → MockLLM (test, CI, hızlı dev)
# openai            → bulut gpt-4o/gpt-4o-mini (v2.3 — EN İYİ kalite; tüm ajanlar: draft,
#                     finalize, dilekçe, HyDE, sorgu-yeniden-yazma, clarifier otomatik kullanır).
#                     OPENAI_API_KEY gerekir (STT/OCR ile aynı anahtar). Qwen YÜKLENMEZ → VRAM açılır.
# llamacpp          → in-proc Python (CUDA toolkit gerek; CI'da kullanma)
# llamacpp_server   → HTTP, prebuilt binary
LLM_MODE=openai
OPENAI_LLM_MODEL=gpt-4o-mini          # max kalite: gpt-4o
# OPENAI_LLM_TIMEOUT_S=120
# OPENAI_STREAM_MAX_CHARS=200000       # SSE akış bellek tavanı (kötü/SSRF proxy OOM guard)
# Kademeli yönlendirme (tiered routing): karmaşık/yüksek-riskli soru → güçlü model, basit → mini.
# Maliyet yalnız zor sorularda artar (gpt-4o ~16× mini). Yalnız LLM_MODE=openai'de etkili.
LLM_TIER_ROUTING=0                     # 1 → aç
OPENAI_LLM_MODEL_COMPLEX=gpt-4o        # karmaşık/yüksek-riskli soru modeli

# llamacpp_server adresi (kendi makinede 8080 default)
LLM_SERVER_URL=http://127.0.0.1:8080

# llamacpp in-proc için GGUF yolu (LLM_MODE=llamacpp seçildiyse zorunlu)
# RTX 4070 12GB interaktif: Qwen3.5-9B-UD-Q4_K_XL (~6GB, ~23 tok/s, Gated DeltaNet, 262k ctx, 201 dil/TR).
# Head-to-head 2-1 Qwen3-8B'yi geçti (judge-workflow: daha az uydurma/sahte-grounding). Apache-2.0.
LLM_MODEL_PATH=models/Qwen3.5-9B-UD-Q4_K_XL.gguf
# Thinking-mode: Qwen3 (hibrit) varsayılan <think> üretir → draft parse'ını bozar + UI'a akar.
# /no_think (llm.py _apply_no_think) + _strip_think backstop ile kapatılır. Qwen3.5-9B'de default
# zaten KAPALI (defansif bırakılır); Qwen2.5'te zararsız.
LLM_NO_THINK=1

# ----------------- STT (konuşma → metin) ----------------------------------
# v2.3: lokal-only zorunluluğu kaldırıldı → bulut STT serbest (en iyi Türkçe doğruluğu).
# auto   → OPENAI_API_KEY varsa OpenAI gpt-4o-transcribe, yoksa lokal faster-whisper
# openai → her zaman bulut dene (anahtar yoksa lokal'e düşer)
# local  → tam-lokal (gizlilik/offline; bulut çağrısı yok)
STT_PROVIDER=auto
# Bulut STT anahtarı — SECRET, asla commit etme. Boşsa otomatik lokal'e düşülür.
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe   # daha ucuz: gpt-4o-mini-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1   # Azure/proxy için override
# OPENAI_STT_MAX_BYTES=25165824        # ön-yükleme boyut kıskacı (~24MB; OpenAI 25MB reddeder)
STT_CLOUD_FALLBACK=1                  # bulut patlarsa lokal faster-whisper'a düş
# Lokal STT (fallback / local mod) — kalite için large-v3-turbo + GPU önerilir:
# STT_MODEL=large-v3-turbo
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16

# ----------------- OCR (belge/görsel → metin) -----------------------------
# Foto/taranmış belgeden veri okuma. v2.3: bulut serbest → en iyi Türkçe doğruluğu.
# auto   → OPENAI_API_KEY varsa OpenAI vision (gpt-4o-mini), yoksa lokal RapidOCR/Tesseract
# openai → her zaman bulut vision dene (anahtar yoksa lokal'e düşer)
# local  → tam-lokal (gizlilik/offline). NOT: dijital PDF (PyMuPDF) + Word .docx (python-docx)
#          her zaman lokal/kusursuz okunur — yalnız foto/taranmış sayfa buluta gider.
OCR_PROVIDER=auto
OPENAI_OCR_MODEL=gpt-4o-mini          # daha güçlü: gpt-4o
OPENAI_OCR_MAX_TOKENS=4096            # uzun sayfa metni tavanı
# OPENAI_OCR_MAX_DIM=2200              # en uzun kenar > bu → downscale (bellek/maliyet/latency)
OCR_CLOUD_FALLBACK=1                  # bulut patlarsa lokal motora düş
# (OPENAI_API_KEY yukarıdaki STT bölümünde — OCR de aynı anahtarı kullanır)

# ----------------- TTS (metin → sesli okuma) ------------------------------
# auto = OPENAI_API_KEY varsa OpenAI TTS (doğal Türkçe ses), yoksa lokal Piper.
# openai = her zaman bulut dene. local = tam-lokal (Piper).
TTS_PROVIDER=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts      # tts-1 / tts-1-hd de geçerli
OPENAI_TTS_VOICE=alloy                # alloy/echo/fable/onyx/nova/shimmer (çok dilli)
# OPENAI_TTS_MAX_BYTES=10485760        # yanıt boyut tavanı (~10MB; kötü proxy OOM guard)
TTS_CLOUD_FALLBACK=1                  # bulut patlarsa Piper'a düş

# ----------------- Verify strict / fail-closed -----------------------------
# Production fail-closed doğrulama. Verifier hazır değilse sessiz geçmek yerine
# güvenli hata/reddet davranışı hedeflenir.
VERIFY_STRICT=1

# ----------------- Verify LLM-judge (opt-in) ------------------------------
# 1 → pass verdict'inde OpenAI'ye "cevap kaynaklarca temellendirilmiş mi?" sorulur; hayırsa
# pass engellenir (yalnız SIKILAŞTIRIR, fail-open). Her istekte ekstra çağrı (gecikme+maliyet)
# + kalibrasyon A/B'si gerektirir → ölçmeden production'da AÇMA. Default KAPALI.
VERIFY_LLM_JUDGE=0
OPENAI_JUDGE_MODEL=gpt-4o-mini
# Yalnız YÜKSEK-RİSKLİ soruda (süre/zamanaşımı/hak-kaybı/icra) judge'u otomatik aç — global
# VERIFY_LLM_JUDGE=0 kalsa bile. Maliyet sadece riskli soruda; yalnız sıkılaştırır (fail-open).
VERIFY_LLM_JUDGE_HIGH_RISK=0          # 1 → aç

# ----------------- RAG / Retrieval ----------------------------------------
# Adaptive Routing (A/B verilerine dayalı — 2026-05-30)
# ADAPTIVE_ROUTING_ENABLED=1 → domain+complexity bazlı HyDE/MQ seçimi
# HYDE_ENABLED_DOMAINS: sadece bu domainlerde HyDE aktif (+12-20pp)
# MULTI_QUERY_ENABLED_DOMAINS: sadece bu domainlerde MQ aktif (+14-20pp)
ADAPTIVE_ROUTING_ENABLED=1
HYDE_ENABLED=1
HYDE_ENABLED_DOMAINS=tuketici,kira,isHukuku,vergi
MULTI_QUERY_ENABLED=1
MULTI_QUERY_ENABLED_DOMAINS=trafik,kira,idari
QUERY_COMPLEXITY_THRESHOLD=0.4

# Step-back query rewrite (opt-in, default 0 — DAHA FAZLA ÖLÇÜM GEREK).
# Konuşma-dili sorguyu (complexity>=eşik) resmî hukuki terimlere çevirip AYRI arar +
# RRF ile havuza katar VE rewrite'ı RERANK sorgusu yapar → cross-encoder ranking-reversal'ı
# (konuşma-dili → yanlış madde, madde_recall@5=0.35 kök-neden) hedefler. Lokal LLM (1 çağrı).
# E2E (2026-06-04): tetiklendiğinde OLUMLU (kıdem conf 0.487→0.637, temiz rewrite) AMA in-process
# 14B'de 6s timeout'ta 2/3 çağrı düştü → timeout 12s'e çıkarıldı; kanıt zayıf/gürültülü (n=3) →
# flip için daha geniş eval gerek. Server modunda (paralel LLM) daha pratik. Ölç:
#   QUERY_REWRITE_ENABLED=1 <gpu-env> uv run python -m scripts.test_answers
#   EVAL_STEP_BACK=1 QUERY_REWRITE_ENABLED=1 <embed+llm env> uv run python -m scripts.eval_run --version v2
QUERY_REWRITE_ENABLED=0
QUERY_REWRITE_TIMEOUT_S=12.0

# Canlı emsal fallback (CRAG, opt-in) — lokal corpus ZAYIFSA internetten (yargı-mcp) dava çek.
# Lokal emsal en-iyi rerank skoru EMSAL_LIVE_TRIGGER_SCORE altındaysa domain-uygun canlı
# kaynaktan (trafik→sigorta_tahkim, vergi→gib_ozelge, idari→danistay/sayistay, diğer→yargitay)
# aday çekilir + LOKAL rerank ile sıralanır (public yargı-mcp relevance vermez; alakayı bizim
# cross-encoder verir). Eşik-üstü yoksa GÜRÜLTÜ eklemez (dürüst 'emsal yok'); canlı snippet'ler
# verify'dan geçer (sıfır-halüsinasyon korunur). DÜRÜST SINIR: Tüketici Hakem Heyeti yargı-mcp'de
# YOK → tüketicide sınırlı; en çok trafik/vergi'de fayda (ölçüldü, E2E doğrulandı 2026-06-04).
# Network + latans → yalnız corpus-zayıf sorularda tetiklenir.
EMSAL_LIVE_FALLBACK_ENABLED=1
EMSAL_LIVE_TRIGGER_SCORE=0.35
EMSAL_LIVE_MIN_SCORE=0.30

# Spekülatif Arama (kullanıcı latans garantisi)
# hybrid HEMEN başlar, HyDE/MQ max SPECULATIVE_DEADLINE_S bekler; sonra hybrid fallback.
# Kullanıcı max ~2.3s bekler (Mursit P95=27ms + 2000ms deadline).
SPECULATIVE_ENABLED=1
SPECULATIVE_DEADLINE_S=2.0

# HyDE: dense kanalı LLM-üretimi hipotetik metne göre embed et
# Sprint-4 W1: 2s default Qwen 14B Q4 ile silent-timeout yaratıyordu (200 token
# üretim ~15s). 15s production-safe; hızlı LLM'lerle 5s yeterli.
HYDE_TIMEOUT_S=15.0

# Multi-query expansion (Sprint-4 W1: N=5, JSON-mode, RRF k env-toggle)
MULTI_QUERY_N=5
MULTI_QUERY_TIMEOUT_S=8.0
# Typo tolerance: deterministic internal query variants; user-visible question is unchanged.
# Numbers, article references and law codes are protected from fuzzy correction.
TYPO_TOLERANCE_ENABLED=1
ELIGIBILITY_ENABLED=0
DEBATE_LLM_ON_RETRY=0
# Sprint-4 W1.6 sweep target: 40, 60 (standart), 80, 100 — Türkçe hukukta
# en iyi k'yi freeze_baseline ile ölç.
RRF_K=60

# Sprint-4 W1.4: Pre-domain filter (mevzuat post-retrieve boost).
# Mevzuat seed'lerde `domain` field yok ama `kanun_kodu` var; triaj domain'i
# DOMAIN_TO_KANUN_KODU mapping ile uyumlu kodlu chunk'ların skoru boost ile
# öne çıkarılır. Re-seed gerektirmez.
MEVZUAT_DOMAIN_FILTER=1
MEVZUAT_DOMAIN_BOOST=0.15

# Tier-3 SOTA toggle'ları (default kapalı, Sprint-7/8'de etkin)
CRAG_ENABLED=0
SELF_RAG_ENABLED=0
RAPTOR_ENABLED=0
GRAPH_RAG_ENABLED=0

# ----------------- Embedding / Reranker -----------------------------------
# Domain-aware dual embedder (2026-05-30):
#   Mursit dense (768-dim, Yargıtay trained) + BGE-M3 sparse (vergi/trafik/icra)
#   Benchmark v2 186 vaka: domain@1=80.1%, kanun@5=50.5%, MRR=0.877, P95=45ms
#   vs BGE-M3:              domain@1=81.2%, kanun@5=43.5%, MRR=0.881, P95=78ms
EMBEDDING_MODEL=newmindai/Mursit-Base-TR-Retrieval
QDRANT_COLLECTION=adalet_mursit_hybrid
# vergi/trafik/icra: keyword-heavy → BGE-M3 sparse +7-36pp domain@1
SPARSE_EMBEDDER_MODEL=BAAI/bge-m3
SPARSE_ENABLED_DOMAINS=vergi,trafik,icra
# Füzyon: rrf (default) | dbsf (Distribution-Based Score Fusion). Yalnız sparse-enabled
# domainde (2 kol) tetiklenir. ÖLÇÜLDÜ A/B (eval/runs/fusion_*.json): headline madde_recall@5
# FLAT (35.4→35.7%), AMA trafik domain@1 +18pp / icra +4pp (BM25 ölçek-normalizasyonu),
# domain@5/kanun@5 -0.5pp. Default RRF; trafik/icra ağırlıklı dağıtımda HYBRID_FUSION=dbsf dene.
HYBRID_FUSION=rrf
EMBEDDING_DEVICE=cuda      # cpu | cuda
EMBEDDING_FP16=1

RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_FP16=1

# Rerank sağlayıcı: local (cross-encoder bge-reranker-v2-m3, DEFAULT) | bgem3 (BGE-M3
# multi-vector dense+sparse+ColBERT). ÖLÇÜLDÜ (eval_run v2 law, 165 vaka): bgem3 ColBERT
# token-level MAX_SIM doğru-madde seçimini iyileştirir → madde_recall@5 37.0%→42.2% (+5.2pp),
# madde_mrr 0.327→0.365 (kanun@5 sabit 82% — yani "doğru kanunun doğru maddesi" disambiguation).
# OPT-IN: BGE-M3 (~2GB) Qwen ile aynı GPU'ya sığmazsa COLBERT_RERANK_DEVICE=cpu → warm +~15s
# latency. GPU headroom varsa COLBERT_RERANK_DEVICE=cuda hızlı + kazançlı.
RERANK_PROVIDER=local
COLBERT_RERANK_DEVICE=cpu                # bgem3 için BGE-M3 cihazı (cpu: OOM-güvenli, yavaş)
COLBERT_RERANK_WEIGHTS=0.4,0.2,0.4       # dense,sparse,colbert (FlagEmbedding MLDR dengesi)

# Dava-sonucu tahmini (8. ajan — PredictionCard). Display-only, 0.85-cap,
# verify'ı override ETMEZ, her tahminde disclaimer + min-emsal guard (<2 emsal →
# "belirsiz", kendinden emin yanıltıcı tahmin yok). ENABLED=1 → çıktıda tahmin kartı.
PREDICTIVE_ENABLED=0          # 1 = tahmin ajanı aktif (emsal'den dava sonucu sinyali)
PREDICTIVE_USE_MODEL=1        # 1 = checkpoints/best (0.73 BERT-TR); checkpoint yoksa heuristic

# ColBERT late-interaction (Sprint-4 W1+: production default ON)
# COLBERT_ENABLED=1     → encode() ColBERT vec döndürür + ensure_collection ile
#                         yeni schema'da `colbert` named vector oluşur (on_disk).
# COLBERT_QUERY_ENABLED → 3-kol prefetch (dense+sparse+colbert) RRF fusion.
# Mevcut collection ColBERT içermiyorsa hybrid_search 2-kol fallback yapar
# (collection_has_colbert runtime tespiti). Migrate için reseed gerekir.
COLBERT_ENABLED=1
COLBERT_QUERY_ENABLED=1

# ----------------- NLI / LettuceDetect ------------------------------------
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_FP16=1
LETTUCE_ENABLED=1
LETTUCE_MODEL=KRLabsOrg/lettucedetect-large-v1-turkish

# CLATTER entailment kapısı — ÖLÇÜLDÜ-GÜVENLİ, production'da AÇIK (E2E 2026-06-04).
# Süre/eşik gerekçeli uygunluk-sonucu iddiaları ("2 yıl → kıdem alabilirsiniz" / "2 yıl →
# yetersiz") için POZİTİF NLI entailment ŞART; neutral/yalnız-fuzzy YETERSİZ → pass engellenir
# (retry/reject). Çıkarım-halüsinasyonunun fuzzy'den kaçan sınıfını kapatır (CLATTER arXiv 2506.05243).
# E2E (gerçek Qwen+NLI, kira/kıdem/tüketici): over-reject YOK — kıdem'de kapı ateşlenip retry→pass
# (geçerli cevap re-grounding ile hayatta, kalite aynı). Yalnız NLI yüklüyken anlamlı (mock/dev'de
# over-reject → kod default 0 KALIR, test/NLI-siz dev güvenli; bu dosya production reçetesidir).
CLATTER_GATE_ENABLED=1

# Citation-grounding kontrolü — ÖLÇÜLDÜ-GÜVENLİ, production'da AÇIK. 'correct ≠ faithful':
# cite_ids taşıyan iddialarda FUZZY tek başına yetmez → cite hedefi gerçekten temellendirmeli
# (lettuce/NLI entailment). Misgrounded citation (doğru madde-no + yanlış içerik atfı) yakalar.
# CLATTER ile zincirlenir; E2E'de over-reject gözlenmedi. Kod default 0 (NLI-siz dev güvenli).
CITE_GROUNDING_CHECK=1

# Guided-decoding citation-whitelist — ÖLÇÜLDÜ-GÜVENLİ, production'da AÇIK. claim-extraction'da
# cite_id'i known_ids ENUM'una JSON-schema→GBNF ile DECODE-seviyesinde kısıtlar → uydurma cite
# ÜRETİLEMEZ (CITE_GROUNDING_CHECK ile sinerjik). E2E (in-process Qwen 14B): schema→GBNF kabul
# edildi, crash/fallback YOK, claim çıkarımı normal. NLI bağımlılığı YOK (over-reject riski yok);
# grammar destekleyen LLM'de etkin (MockLLM yok sayar). Kod default 0 (test güvenli).
GUIDED_CITE_ENABLED=1

# ----------------- Vector DB / Cache --------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=                # production'da set et
# NOT: QDRANT_COLLECTION yukarıda Embedding bölümünde tanımlı (adalet_mursit_hybrid).
# Burada TEKRAR set ETME — startup boyut doğrulaması (assert_collection_dim) EMBEDDING_MODEL
# ile koleksiyon boyutunun uyuştuğunu kontrol eder; çift tanım kafa karıştırır.

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=                # production'da set et

# ----------------- API / CORS / Server ------------------------------------
# Virgülle ayrılmış allowed origin listesi. "*" kullanırsan credentials kapanır.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://adalet.app

# uvicorn host/port (Docker'da 0.0.0.0:8000 default)
API_HOST=0.0.0.0
API_PORT=8000

# Rate limiting (slowapi — Sprint-4 W6.2 + Sprint-6 W6.5 dynamic per-principal)
# Sprint-6: principal_kind="api_key" → ASK_RATE_API_KEY, diğer → ASK_RATE
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_ASK_API_KEY=60/minute
RATE_LIMIT_STORAGE_URI=memory://
# Eski env (geriye uyumluluk — kullanılmıyor, deprecated)
# RATE_LIMIT_PER_MIN=30

# ----------------- Auth (güvenlik C1/C2) ----------------------------------
# FAIL-SECURE: AUTH_ENABLED set EDİLMEZSE "1" (açık) varsayılır → yanlışlıkla korumasız
# production olmaz. Lokal dev için EXPLICIT "0" yaz. Production'da ENV=production +
# AUTH_ENABLED!=1 → startup ÇÖKER (fail-fast, main.py).
AUTH_ENABLED=1
# Production ortam işareti (production → auth misconfig'de fail-fast).
ENV=development
# Token sağlayıcı: supabase (frontend supabase-js GoTrue JWT) | internal (kendi JWT'miz).
AUTH_PROVIDER=supabase
# MODERN ES256 (asimetrik) projeler: yalnız proje URL'i yeter — backend public anahtarı
# JWKS'ten otomatik çeker, PAYLAŞIMLI SECRET YOK. Frontend ile aynı (VITE_SUPABASE_URL).
SUPABASE_URL=https://<proje-ref>.supabase.co
# LEGACY HS256 (eski simetrik projeler) fallback — modern ES256'da BOŞ bırak.
# Dashboard → JWT Keys → Legacy JWT Secret (yalnız legacy projede gerekir).
SUPABASE_JWT_SECRET=
# internal JWT imzalama (AUTH_PROVIDER=internal; `openssl rand -hex 32`). supabase modunda gereksiz.
JWT_SECRET=

# Session store — multi-turn konuşma persist
# Production: redis (docker-compose.yml SESSION_STORE_KIND=redis kullanır)
# Dev: memory (in-process dict)
# Eski env adı: SESSION_STORE (hâlâ fallback olarak kabul ediliyor)
SESSION_STORE_KIND=memory
SESSION_TTL_S=3600
SESSION_MAX_TURNS=20

# Feedback persist path — production read-only fs container'da named volume mount
# Default `data/feedback` dev için. Production: `/var/lib/adalet/feedback` (compose).
FEEDBACK_LOG_DIR=data/feedback

# ----------------- Observability ------------------------------------------
# Langfuse (opsiyonel) — trace + cost takibi
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Log seviyesi (structlog)
LOG_LEVEL=INFO

# ----------------- HuggingFace --------------------------------------------
# CI/Docker'da offline kullan; ilk model indirimi için 0 yap
HF_HUB_OFFLINE=1
HF_HOME=/models

# ----------------- Windows / Encoding -------------------------------------
# Türkçe karakter güvenliği (Windows cp1254 fix); Linux'ta da zararsız
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# ----------------- Test / Eval --------------------------------------------
# Lifespan preload'i CI'da kapat (mock kullanırken model indirme yok)
PRELOAD_MODELS=1

# ----------------- Firecrawl (tam-metin yedeği) ---------------------------
# yargi-mcp kararın/mevzuatın tam metnini getiremezse (not_found/rate_limited), Firecrawl
# kararın BİLİNEN resmi URL                           inden temiz markdown çeker. YALNIZ resmi hukuki host allowlist
# (mevzuat/anayasa/yargitay/danistay/uyap/resmigazete) çekilir. Boşsa yedek atlanır.
# SIFIR HALÜSİNASYON: içerik doğrudan resmi sayfadan (model üretmez). retrieval/firecrawl_client.py
FIRECRAWL_API_KEY=

# Query decomposition (multi-hop): çok-parçalı soru → alt-sorular → her birine retrieve + birleştir.
DECOMPOSE_ENABLED=1

# Corrective RAG: retrieval zayıfsa multi-query re-retrieve (öz-düzeltme).
CRAG_ENABLED=1
