# Bağımlılıklar
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# MCP config (proje-yerel; proje-ref/secret içerebilir — accidental commit guard)
.mcp.json
.pub-cache/
.dart_tool/

# Build
dist/
build/
.next/
out/
*.tsbuildinfo

# Flutter
mobile/build/
mobile/ios/Pods/

# Ortam
.env
.env.local
!.env.example

# Editör / OS
.vscode/
.idea/
.claude/
# vendored agent-skills içeriği — skills-lock.json'dan yeniden üretilir
.agents/
.DS_Store
Thumbs.db

# Log
*.log
*.err
logs/

# ML / veri
data/training/raw/
*.ckpt
*.pt
*.safetensors
*.gguf
*.onnx
*.traineddata

# Models (Qwen GGUF, Whisper bin, Piper ONNX, Tesseract tessdata)
backend/models/

# Predictive — eğitim verisi (büyük JSONL) + checkpoint dizini (16GB model artifact)
backend/data/predictive/
backend/predictive/checkpoints/

# Reranker (Faz-4) — corpus.jsonl ~120MB + üretilen çiftler/triplet (regenerable;
# load_sources/synth_queries/mine_negatives kullanıcı kutusunda yeniden üretir)
backend/data/reranker/

# Smoke test artifacts (büyük JSON output)
backend/data/smoke_runs/

# Eval run çıktıları (generated; .md audit raporları tracked kalır)
backend/eval/runs/*.json

# /feedback endpoint test/runtime artifacts (her gün YYYYMMDD.jsonl)
# Test'ler conftest.py autouse fixture ile tmp'ye yönlendirilir; ama eski
# committed dosyalar varsa ignore et — production'da named volume kullanılır.
backend/data/feedback/*.jsonl

# İlgili Kararlar tam-metin kalıcı cache (on-demand dolar; resmi kaynaktan çekilen metin)
backend/data/fulltext_cache.sqlite*

# Test
coverage/
.coverage
htmlcov/

# Geçici
tmp/
*.tmp
_eval*.txt
_eval*.json

# Playwright MCP test artifacts
.playwright-mcp/

# Playwright E2E artifacts
frontend/test-results/
frontend/playwright-report/
frontend/.last-run.json

# Session scratch / probe çıktıları (kazara commit önle)
.run/
/stepper-*.png
backend/eval/runs/*.txt
backend/scripts/*_probe.py

# LoRA adapter ciktilari (egitimle uretilir, repo'ya girmez)
backend/data/lora/
