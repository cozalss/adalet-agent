{
	# Sprint-4 W9.1 — Caddy 2 production config
	email ops@adalet.app
	# Admin API'yi KAPAT — default localhost:2019 açık olur; Caddy container
	# adalet-net içindeyse kompromize bir container :2019/config ile upstream'i
	# değiştirebilir (reverse-proxy hijack). Deploy CLI'ya gerek yok.
	admin off
	# ACME auto-TLS (Let's Encrypt prod by default)
	# Test için: acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2 h3
	}
}

# ---------------------------------------------------------------------------
# staging.adalet.app — beta deploy
# ---------------------------------------------------------------------------
staging.adalet.app {
	# Auto-TLS (HTTPS+HSTS)
	tls {
		protocols tls1.2 tls1.3
	}

	encode gzip zstd

	# Güvenlik header'ları
	header {
		# HSTS — 1 yıl, alt-domain'leri kapsa, preload list eligibility
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Clickjack koruması
		X-Frame-Options "DENY"
		# MIME sniff blok
		X-Content-Type-Options "nosniff"
		# XSS reflectif koruma (legacy ama zarar yok)
		X-XSS-Protection "1; mode=block"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Browser feature lockdown
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
		# CSP — tek-origin (Caddy hem SPA hem API sunar). Vite inline script/style + Supabase
		# bağlantısı + font/img izinleri. (vercel.json CSP ile hizalı; denetim #21.)
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
		# Server banner kaldır
		-Server
	}

	# Health endpoint ekstra header gerektirmesin
	@health path /health
	handle @health {
		reverse_proxy backend:8000
	}

	# API endpoint'leri — backend container. Frontend relative-path çağırır → TÜM backend
	# yolları burada olmalı (denetim #21: /me=geçmiş/tercih/dosya, /api, /metrics eksikti →
	# kayıtlı kullanıcı prod'da 404 alıyordu).
	@api path /ask* /api/* /me/* /multimodal/* /auth/* /feedback* /metrics*
	handle @api {
		reverse_proxy backend:8000 {
			# Backend rate-limit X-Forwarded-For ile gerçek IP görsün
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			# SSE stream için buffer kapat
			flush_interval -1
			# Takılı/yavaş backend Caddy worker'larını tüketmesin (slowloris).
			# OCR/STT uzun sürebildiğinden read_timeout cömert; dial kısa.
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
				read_timeout 180s
			}
		}
	}

	# Docs — staging'de BİLİNÇLİ açık (beta tester'lar Swagger kullanır).
	# PRODUCTION'a kopyalarken bu bloğu KALDIR veya IP-whitelist'le: OpenAPI
	# şeması endpoint/PII-field/internal-path yapısını ifşa eder (bilgi sızıntısı).
	@docs path /docs /openapi.json /redoc
	handle @docs {
		reverse_proxy backend:8000
	}

	# Frontend SPA (Vite build) — tek-origin: Caddy statik SPA'yı sunar, geri kalan tüm
	# yollar API matcher'a düştü. compose `./frontend/dist`'i /srv/frontend'e mount eder
	# (deploy ÖNCESİ `cd frontend && npm run build`). try_files → SPA client-side routing fallback.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	# Access log (JSON)
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 14
			roll_keep_for 720h
		}
		format json
	}
}

